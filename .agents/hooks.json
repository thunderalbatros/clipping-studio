{
  "workspace-security-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|read_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "..\\.venv\\Scripts\\python.exe ..\\scripts\\security_pretool_hook.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "rtk-shell-compressor": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "..\\.venv\\Scripts\\python.exe ..\\scripts\\rtk_pretool_hook.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

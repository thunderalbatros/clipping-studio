# ==============================================================================
# Clipping Studio — .env.example
# Copiar a `.env` y completar valores reales. NUNCA commitear `.env`.
# ==============================================================================

# --- Perfil de Computo (Regla de Degradacion Elegante) ---
# Opciones: local_hp | gcp_spot_l4 | colab_t4
COMPUTE_PROFILE=local_hp

# --- Modo Inicial de Produccion ---
# Opciones: streamer_gta6_lite | podcast_en | editorial
STUDIO_MODE=streamer_gta6_lite
# Regla de voz: none (default Bounties CPM) | human_batch (Shure SM58) | tts
VOICE_MODE=none

# --- Proveedores LLM (Escalera de Resiliencia Anti-429/503) ---
# Primario Sprint (Vertex AI con creditos GCP) o AI Studio (Google AI Pro)
USE_VERTEX_AI=true
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_MODEL=gemini-4-flash
# Opcional: rotacion AI Studio (separadas por coma si hay mas de una)
GEMINI_API_KEY=

# Fallbacks gratuitos (patron clipmint)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- GCP FinOps Guardrails (Acelerador USD 30) ---
GCP_SPOT_ZONE=us-central1-a
GCP_GCS_BUCKET=
GCP_IDLE_SHUTDOWN_MINUTES=12

# --- Ingesta y Plataformas ---
# Ruta a cookies.txt exportado desde Firefox o sesion incognito cerrada (NO usar --cookies-from-browser en Windows)
YT_COOKIES_PATH=
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# --- HuggingFace (solo modelos comerciales aprobados; gated models como pocket-tts/pyannote) ---
HF_TOKEN=
HF_HUB_ENABLE_HF_TRANSFER=1

# --- Radar Diario / HITL Remoto (Fase 1.3+ / Fase 2) ---
SERPER_API_KEY=
FIRECRAWL_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Conocimiento (Qdrant — Solo Lectura en v1; Hibrido Empirico en Fase 2 post-100 clips) ---
QDRANT_HOST=
QDRANT_API_KEY=
QDRANT_COLLECTION_OBSIDIAN=
# Deshabilitado en v3.4.1 (no existe aun en Qdrant Cloud; activar solo en Fase 2 post-100 clips)
# QDRANT_COLLECTION_CLIPPING_V2=clipping_studio_empirical

# --- Monetizacion / Bounties (Fase 2 opcional) ---
WHOP_API_KEY=
